{
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "onCreateCommand": {
    "generate-config": "bash .devcontainer/post-create.sh"
  },
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "remoteUser": "vscode",
  "remoteEnv": {
    "FLYTE_PROJECT_DIR": "${containerWorkspaceFolder}"
  },
  "containerEnv": {
    "FLYTE_ADMIN_ENDPOINT": "localhost:30080",
    "FLYTE_INSECURE": "true"
  },
  "forwardPorts": [30080],
  "mounts": [
    "source=${localWorkspaceFolder},target=${containerWorkspaceFolder},type=bind,consistency=cached"
  ],
  "persistToGitignore": ["**/__pycache__", "**/*.pyc"]
}
